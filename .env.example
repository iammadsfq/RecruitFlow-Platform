PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruitflow?schema=public"

# Authentication Secrets
JWT_SECRET="recruitflow_jwt_secret_dev_only_change_in_production"
ROBOT_API_TOKEN="rf_robot_bearer_token_dev_secret_key_123456"

# Business Rules Settings
CONFIRMATION_WINDOW_HOURS=24
OVERBOOKING_PERCENTAGE=20
MAX_UPLOAD_SIZE_MB=5

# Storage
UPLOAD_DIR="./uploads"
